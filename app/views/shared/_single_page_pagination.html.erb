<% page_url = url_for(request.path_parameters.merge(request.query_parameters).merge(pagination_params).merge(page: 1)) %>

<nav class="mt-6 flex justify-center border-t border-gray-100 pt-5"
     role="navigation"
     aria-label="<%= t("views.pagination.aria_label") %>">
  <div class="flex max-w-full flex-wrap items-center justify-center gap-1.5">
    <%= link_to "1",
                page_url,
                class: "inline-flex h-9 min-w-9 items-center justify-center rounded-full bg-amber-600 px-3 text-sm font-bold text-white shadow-sm transition-colors hover:bg-amber-700",
                aria: {
                  current: "page",
                  label: t("views.pagination.page", page: 1)
                } %>
  </div>
</nav>
