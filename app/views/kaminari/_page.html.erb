<% if page.current? %>
  <span class="inline-flex h-9 min-w-9 items-center justify-center rounded-full bg-amber-600 px-3 text-sm font-bold text-white shadow-sm"
        aria-current="page">
    <%= page %>
  </span>
<% else %>
  <%= link_to page,
              url,
              remote: remote,
              rel: page.rel,
              aria: { label: t("views.pagination.page", page: page) },
              class: "inline-flex h-9 min-w-9 items-center justify-center rounded-full border border-gray-200 bg-white px-3 text-sm font-semibold text-gray-700 transition-colors hover:border-amber-300 hover:text-amber-700" %>
<% end %>
